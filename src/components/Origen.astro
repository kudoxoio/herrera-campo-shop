---
// ORIGEN — three columns of provenance: leather, wool, silver.
const origins = [
  {
    title: 'Cuero · León, Guanajuato',
    body: 'Curtido vegetal en Pozos. 30 días en tina de roble. Sin cromo, sin metales pesados. La bota respira y envejece contigo.',
    accent: '#C68A3A',
  },
  {
    title: 'Lana · Tlaxcala',
    body: 'Hilo tejido en telar de pedal desde 1840. Colorantes naturales: cochinilla, índigo, nogal. Cada sarape es una sola pieza continua sin costuras.',
    accent: '#6E5B43',
  },
  {
    title: 'Plata · Taxco',
    body: 'Plata .925 repujada a mano por la familia Mendoza desde 1923. Cada hebilla tarda 3 días en salir del taller.',
    accent: '#B8A285',
  },
];
---

<section
  id="origen"
  class="bg-cream text-ink py-20 md:py-32 px-6 md:px-12"
  aria-labelledby="origen-heading"
>
  <header class="max-w-6xl mx-auto mb-12 md:mb-20">
    <p class="font-utility text-ink-secondary mb-3 md:mb-4">Procedencia · trazabilidad</p>
    <h2 id="origen-heading" class="font-display text-ink text-5xl md:text-8xl tracking-tight leading-none">
      El origen
    </h2>
  </header>

  <ul class="grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-16 max-w-6xl mx-auto">
    {origins.map((o) => (
      <li class="border-t pt-6 md:pt-8" style={`border-color: ${o.accent};`}>
        <span class="block w-3 h-3 rounded-full mb-4" style={`background: ${o.accent};`} aria-hidden="true"></span>
        <h3 class="font-display text-2xl md:text-3xl mb-3 leading-tight">{o.title}</h3>
        <p class="font-body text-ink-secondary text-base md:text-lg leading-relaxed">{o.body}</p>
      </li>
    ))}
  </ul>
</section>