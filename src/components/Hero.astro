---
// HERO — scroll-scrub video, massive Playfair h1, countdown timer, single CTA.
// Uses a Preact island for the countdown (client-side ticking).
// On mobile, falls back to autoplay muted + intersection-observer pause.
import HeroVideo from '~/components/islands/HeroVideo';
import CountdownTimer from '~/components/islands/CountdownTimer';
import { heroVideoUrl } from '~/data/products';
---

<section
  id="hero"
  class="relative w-full h-screen overflow-hidden bg-ink"
  aria-label="Hero"
>
  <!-- Background video (desktop: scroll-scrubbed via canvas; mobile: autoplay) -->
  <HeroVideo client:load src={heroVideoUrl} />

  <!-- Dark overlay for legibility -->
  <div
    class="absolute inset-0 bg-gradient-to-b from-black/30 via-black/40 to-black/60 pointer-events-none"
    aria-hidden="true"
  ></div>

  <!-- Foreground content -->
  <div
    class="relative z-10 h-full flex flex-col justify-center items-center text-center px-6 md:px-12 text-cream"
  >
    <p
      class="font-utility text-cream/80 mb-4 md:mb-6"
      data-hero-eyebrow
    >
      Temporada de Oro · Edición Limitada
    </p>

    <h1
      class="font-display text-cream text-[14vw] md:text-[10vw] lg:text-[9rem] leading-[0.95] tracking-tight mb-6 md:mb-10"
      data-hero-title
      aria-label="HERRERA & CAMPO — Temporada de Oro"
    >
      <span aria-hidden="true" class="block" data-hero-line>HERRERA &amp; CAMPO</span>
    </h1>

    <p class="font-utility text-cream/70 mb-3 md:mb-4">
      Lanzamiento
    </p>

    <div
      class="mb-8 md:mb-12 text-cream text-2xl md:text-4xl tabular-nums"
      aria-live="polite"
    >
      <CountdownTimer client:load />
    </div>

    <p class="font-utility text-cream/60 text-[0.65rem] md:text-xs mb-8 md:mb-12">
      MX, viernes 14 de noviembre, 20:00 hrs
    </p>

    <a
      href="#grid"
      class="group inline-flex items-center gap-3 border border-cream/80 px-8 md:px-12 py-4 md:py-5 font-utility text-cream hover:bg-accent hover:border-accent transition-colors duration-300"
    >
      Ver la colección
      <span class="inline-block translate-y-[-1px] transition-transform group-hover:translate-y-0" aria-hidden="true">↓</span>
    </a>
  </div>
</section>
