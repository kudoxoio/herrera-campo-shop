---
// Base layout — fonts, meta, theme color, root container.
import '~/styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'HERRERA & CAMPO — Temporada de Oro',
  description = 'Herencia charra y vaquera. Cuero curtido vegetal en León, plata repujada en Taxco, lana de Tlaxcala. Edición limitada.',
} = Astro.props;
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#F4EFE6" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="bg-cream text-ink antialiased">
    <slot />
  </body>
</html>
