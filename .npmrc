# pnpm config — strict mode + security defaults.
# Reference: https://pnpm.io/npmrc

# Strict peer dep resolution. Fails the install if a peer dep is missing
# instead of silently using a hoisted version. Catches drift early.
strict-peer-dependencies=true

# Auto-install peers so developers don't have to add them by hand.
# Combined with strict-peer-dependencies, this enforces they exist at the right version.
auto-install-peers=true

# Approved build scripts live in pnpm-workspace.yaml (`allowBuilds`).
# Defense-in-depth: pnpm refuses to run install scripts unless explicitly
# whitelisted there (replaces the legacy onlyBuiltDependencies setting).

# Hoist patterns for tools that don't follow pnpm's strict resolution
# (e.g. some IDE integrations, type packages). Real production builds
# still resolve via pnpm's isolated layout.
public-hoist-pattern[]=*types*
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
